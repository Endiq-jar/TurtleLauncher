<?xml version="1.0" encoding="utf-8"?>
<!--
  TurtleLauncher: dedicated Friends/LAN icon, closing TerracottaVpnService's long-standing
  "TODO: swap for a dedicated Friends/network icon" (the ongoing VPN notification used
  ic_chat, which is also the in-game chat glyph).

  Solid fills and no strokes on purpose: Android draws a notification small icon from its
  alpha channel only, so a thin-stroked vector like ic_globe.xml turns into near-invisible
  hairlines in the status bar. Two solid person glyphs at 24dp read as "friends" even at
  status-bar size.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- Front person: head + shoulders -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M9,4.5a3.25,3.25 0,1 0,0.001 0z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M9,12.5c-3.6,0 -6.5,2.9 -6.5,6.5h13c0,-3.6 -2.9,-6.5 -6.5,-6.5z" />
    <!-- Second person, behind and to the right -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M17.5,6a2.5,2.5 0,1 0,0.001 0z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M17.5,12c-0.7,0 -1.3,0.1 -1.9,0.3c1.4,1.3 2.3,3.2 2.3,5.2h4.1c0,-3 -2,-5.5 -4.5,-5.5z" />
</vector>
