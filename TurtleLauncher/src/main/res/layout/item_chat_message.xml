<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingVertical="4dp">

    <TextView
        android:id="@+id/message_bubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_weight="0"
        android:padding="12dp"
        android:textSize="14sp"
        android:textColor="@color/turtle_text_primary"
        android:textIsSelectable="true"/>

    <!-- Generated video/audio: a tappable row, since neither can be shown inline. -->
    <TextView
        android:id="@+id/message_file"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/background_grid_card"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:textColor="@color/accent_primary"
        android:textSize="13sp"
        android:visibility="gone"
        tools:ignore="UnusedAttribute"/>

    <!-- Generated images (the Assistant's /image command). Hidden unless the message has one. -->
    <ImageView
        android:id="@+id/message_image"
        android:layout_width="220dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:adjustViewBounds="true"
        android:contentDescription="@string/ai_chat_image_description"
        android:scaleType="fitCenter"
        android:visibility="gone"/>

</LinearLayout>
