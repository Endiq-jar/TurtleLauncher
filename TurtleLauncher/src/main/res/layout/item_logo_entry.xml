<?xml version="1.0" encoding="utf-8"?>
<!-- Grid-cell version of a logo entry (icon centered, name below, checkmark badge
     overlapping the icon's corner when selected) - used in a GridLayoutManager so
     the picker makes use of the launcher's landscape width instead of one long
     column of full-width rows. -->
<com.endiq.turtlelauncher.ui.layout.AnimConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/space_xs"
    android:background="@drawable/background_item_unselected"
    android:paddingVertical="@dimen/space_s"
    android:paddingHorizontal="@dimen/space_xs"
    app:ripple_for_constraint="true"
    tools:ignore="ContentDescription">

    <ImageView
        android:id="@+id/logo_thumb"
        android:layout_width="@dimen/_52sdp"
        android:layout_height="@dimen/_52sdp"
        android:scaleType="centerCrop"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:src="@drawable/ic_turtle_full" />

    <com.endiq.turtlelauncher.ui.view.AnimatedIconView
        android:id="@+id/logo_selected_check"
        android:layout_width="@dimen/_18sdp"
        android:layout_height="@dimen/_18sdp"
        android:background="@drawable/background_item_selected"
        android:padding="2dp"
        android:src="@drawable/ic_check"
        android:tint="@color/accent_primary"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="@+id/logo_thumb"
        app:layout_constraintEnd_toEndOf="@+id/logo_thumb"
        tools:visibility="visible" />

    <com.endiq.turtlelauncher.ui.view.AnimTextView
        android:id="@+id/logo_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="2"
        android:textSize="@dimen/_10ssp"
        android:textColor="@color/turtle_primary_text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/logo_thumb"
        tools:text="Blurple (Default)" />

</com.endiq.turtlelauncher.ui.layout.AnimConstraintLayout>
