<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/_8sdp"
    android:background="@drawable/background_card"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="@dimen/_8sdp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground">

    <FrameLayout
        android:layout_width="96dp"
        android:layout_height="60dp">

        <ImageView
            android:id="@+id/recording_thumbnail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/background_app"
            android:scaleType="centerCrop"
            tools:ignore="ContentDescription"
            tools:src="@drawable/ic_play_circle"/>

        <TextView
            android:id="@+id/recording_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="4dp"
            android:background="#99000000"
            android:paddingHorizontal="4dp"
            android:paddingVertical="1dp"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            tools:text="2:34"/>
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/_8sdp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/recording_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="middle"
            android:singleLine="true"
            android:textColor="@color/turtle_text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="turtle_2026-10-18_12.00.00.000.mp4"/>

        <TextView
            android:id="@+id/recording_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/turtle_text_secondary"
            android:textSize="12sp"
            tools:text="128.4 MB  Oct 18, 2026  12:00"/>
    </LinearLayout>

    <ImageView
        android:id="@+id/recording_share"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="@dimen/_8sdp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_share"
        android:tint="@color/turtle_text_secondary"
        android:contentDescription="@string/generic_share"/>

    <ImageView
        android:id="@+id/recording_delete"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="@dimen/_8sdp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_menu_delete_forever"
        android:tint="@color/turtle_text_secondary"
        android:contentDescription="@string/generic_delete"/>
</LinearLayout>
