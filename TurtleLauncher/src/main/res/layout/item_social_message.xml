<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingVertical="4dp">

    <TextView
        android:id="@+id/message_author"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/turtle_text_secondary"
        android:textSize="10sp" />

    <TextView
        android:id="@+id/message_body"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxWidth="320dp"
        android:paddingHorizontal="@dimen/space_m"
        android:paddingVertical="@dimen/space_s"
        android:textColor="@color/turtle_text_primary"
        android:textIsSelectable="true"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/message_attachment"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:background="@drawable/background_grid_card"
        android:paddingHorizontal="@dimen/space_s"
        android:paddingVertical="@dimen/space_xs"
        android:textColor="@color/accent_primary"
        android:textSize="11sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/message_meta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/turtle_text_disabled"
        android:textSize="10sp" />
</LinearLayout>
