    <!-- ============================================================
         Turtle pastel-green palette
         ============================================================
         The launcher's accent used to be Miuix blue. These are the
         replacement pastel-green variants: 50 is the lightest wash,
         400 is the primary accent, 950 is the ink used on top of it.
         Every semantic token below aliases one of these so the whole
         app (vectors, switches, sliders, pills, focus rings, charts,
         text selection, launcher icon) moves together.
         ============================================================ -->
    <color name="pastel_green_50">#FFEAFBF0</color>
    <color name="pastel_green_100">#FFD8F7E2</color>
    <color name="pastel_green_200">#FFB8EFCB</color>
    <color name="pastel_green_300">#FFA7E8BD</color>
    <color name="pastel_green_400">#FF8FD9A8</color>
    <color name="pastel_green_500">#FF74C793</color>
    <color name="pastel_green_600">#FF58AB77</color>
    <color name="pastel_green_700">#FF3F8757</color>
    <color name="pastel_green_800">#FF2D5C3D</color>
    <color name="pastel_green_900">#FF1B3A28</color>
    <color name="pastel_green_950">#FF0B1F12</color>

