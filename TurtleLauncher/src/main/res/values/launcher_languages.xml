<?xml version="1.0" encoding="utf-8"?>
<!--
  Languages the launcher itself is translated into.

  Settings -> Launcher -> Language used to offer every Minecraft language code
  (all_game_language, ~130 entries) even though the launcher shipped no
  values-* resource folder at all. Picking any of them therefore changed the
  Locale and nothing else - the whole UI stayed English, which is what "the
  language setting does not work" looked like.

  This list contains exactly the languages that have a values-* folder, so every
  entry visibly does something. `tests/check_translations.py` fails if this list
  and the res/values-* folders drift apart in either direction.

  Native language names (endonyms) are intentionally identical in every
  translation, so this array is defined only in the default values/ folder.
-->
<resources>
    <string-array name="launcher_language_names">
        <item>@string/setting_set_game_language_system</item>
        <item>English</item>
        <item>简体中文</item>
        <item>繁體中文</item>
        <item>日本語</item>
        <item>Русский</item>
        <item>Español</item>
        <item>Português (Brasil)</item>
    </string-array>

    <!-- Values use Minecraft-style codes so LocaleHelper.localeFor() parses both
         this picker and the game-language picker identically. "system" follows
         the device language. -->
    <string-array name="launcher_language_values">
        <item>system</item>
        <item>en</item>
        <item>zh_cn</item>
        <item>zh_tw</item>
        <item>ja_jp</item>
        <item>ru_ru</item>
        <item>es_es</item>
        <item>pt_br</item>
    </string-array>

    <string name="setting_launcher_language_summary">Applies immediately. Screens that have no translation yet stay in English.</string>
</resources>
