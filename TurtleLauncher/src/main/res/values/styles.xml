<resources>

    <!-- Base Miuix Application Theme -->
    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="viewInflaterClass">com.endiq.turtlelauncher.ui.miuix.MiuixViewInflater</item>
        <item name="preferenceTheme">@style/PreferenceThemeOverlay.v14.Material</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/miuix_surface</item>
        <item name="android:colorBackground">@color/miuix_surface</item>
        <item name="colorSurface">@color/miuix_surface_container</item>
        <item name="colorOnSurface">@color/miuix_on_surface</item>
        <item name="android:textColor">@color/miuix_on_surface</item>
        <item name="android:textColorPrimary">@color/miuix_on_surface</item>
        <item name="android:textColorSecondary">@color/miuix_on_surface_variant_summary</item>
        <item name="android:textColorHint">@color/miuix_on_secondary_container</item>
        <item name="android:textSize">@dimen/_11ssp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:colorBackgroundCacheHint">@null</item>

        <!-- Miuix Accent & Control Tokens -->
        <item name="colorAccent">@color/miuix_primary</item>
        <item name="colorPrimary">@color/miuix_primary</item>
        <item name="colorPrimaryDark">@color/miuix_surface</item>
        <item name="colorPrimaryVariant">@color/miuix_primary_variant</item>
        <item name="colorSecondary">@color/miuix_primary</item>
        <item name="colorSecondaryVariant">@color/miuix_secondary_variant</item>
        <item name="colorOnPrimary">@color/miuix_on_primary</item>
        <item name="colorOnSecondary">@color/miuix_on_secondary</item>
        <item name="colorError">@color/miuix_error</item>
        <item name="colorControlNormal">@color/miuix_on_surface_variant_summary</item>
        <item name="colorControlActivated">@color/miuix_primary</item>
        <item name="colorControlHighlight">@color/turtle_accent_ripple</item>
        <item name="android:colorControlNormal">@color/miuix_on_surface_variant_summary</item>
        <item name="android:colorControlActivated">@color/miuix_primary</item>
        <item name="android:colorControlHighlight">@color/turtle_accent_ripple</item>

        <!-- Miuix Widget Styles -->
        <item name="android:seekBarStyle">@style/Widget.Turtle.SeekBar</item>
        <item name="seekBarStyle">@style/Widget.Turtle.SeekBar</item>
        <item name="android:switchStyle">@style/Widget.Turtle.Switch</item>
        <item name="switchStyle">@style/Widget.Turtle.Switch</item>
        <item name="alertDialogTheme">@style/CustomAlertDialogTheme</item>
        <item name="android:alertDialogTheme">@style/CustomAlertDialogTheme</item>

        <!-- Fullscreen & Edge-to-Edge -->
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:navigationBarColor">@color/miuix_surface</item>
        <item name="android:statusBarColor">@color/miuix_surface</item>
        <item name="android:scrollbarThumbVertical">@drawable/scrollbar_thumb</item>
        <item name="android:scrollbarSize">3dp</item>
    </style>

    <!-- Miuix SeekBar / Slider Style -->
    <style name="Widget.Turtle.SeekBar" parent="Widget.AppCompat.SeekBar">
        <item name="android:progressDrawable">@drawable/seekbar_progress</item>
        <item name="android:thumb">@drawable/seekbar_thumb</item>
        <item name="android:splitTrack">false</item>
        <item name="android:minHeight">28dp</item>
        <item name="android:maxHeight">28dp</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
    </style>

    <!-- Miuix Switch Style -->
    <style name="Widget.Turtle.Switch" parent="android:Widget.Material.CompoundButton.Switch">
        <item name="android:thumb">@drawable/switch_thumb</item>
        <item name="android:track">@drawable/switch_track_selector</item>
        <item name="android:switchMinWidth">49dp</item>
        <item name="android:thumbTextPadding">8dp</item>
        <item name="android:showText">false</item>
    </style>

    <!-- Miuix SmallTitle Section Header (`top.yukonga.miuix.kmp.basic.SmallTitle`) -->
    <style name="SettingsSectionHeader">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">@dimen/_10sdp</item>
        <item name="android:layout_marginTop">@dimen/_12sdp</item>
        <item name="android:layout_marginBottom">@dimen/_6sdp</item>
        <item name="android:textColor">@color/miuix_on_background_variant</item>
        <item name="android:textSize">@dimen/_11ssp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <!-- Miuix Primary Button Style -->
    <style name="TurtleButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_launch_button</item>
        <item name="android:textColor">@color/miuix_on_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">42dp</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
    </style>

    <!-- Miuix Secondary Button Style -->
    <style name="TurtleButtonOutline" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/background_pill_outline</item>
        <item name="android:textColor">@color/miuix_on_secondary_variant</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>

    <style name="ThickDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0.75dp</item>
        <item name="android:background">@color/miuix_divider_line</item>
    </style>

    <style name="DefaultTabStyle">
        <item name="tab_indicator_drawable">@drawable/selector_bar_vertical</item>
        <item name="tab_indicator_width">@dimen/_4sdp</item>
        <item name="tab_indicator_height">@dimen/_14sdp</item>
        <item name="tab_indicator_style">STYLE_LEFT</item>
        <item name="tab_indicator_y_offset">@dimen/_2sdp</item>
        <item name="tab_indicator_enable_flow">true</item>
        <item name="tab_item_is_equ_width">false</item>
        <item name="tab_enable_gradient_scale">true</item>
        <item name="tab_min_scale">0.96</item>
        <item name="tab_max_scale">1.04</item>
        <item name="tab_enable_ico_color">true</item>
        <item name="tab_enable_text_bold">true</item>
    </style>

    <style name="FullScreenDialog" parent="Theme.MaterialComponents.DayNight.Dialog">
        <item name="viewInflaterClass">com.endiq.turtlelauncher.ui.miuix.MiuixViewInflater</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.60</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="colorAccent">@color/miuix_primary</item>
        <item name="colorPrimary">@color/miuix_primary</item>
        <item name="colorControlActivated">@color/miuix_primary</item>
    </style>

    <!-- Miuix AlertDialog Theme -->
    <style name="CustomAlertDialogTheme" parent="Theme.AppCompat.DayNight.Dialog.Alert">
        <item name="viewInflaterClass">com.endiq.turtlelauncher.ui.miuix.MiuixViewInflater</item>
        <item name="android:background">@color/miuix_background</item>
        <item name="android:windowBackground">@drawable/background_card</item>
        <item name="android:textColorPrimary">@color/miuix_on_background</item>
        <item name="android:textColorSecondary">@color/miuix_on_surface_secondary</item>
        <item name="colorAccent">@color/miuix_primary</item>
        <item name="colorPrimary">@color/miuix_primary</item>
        <item name="colorControlActivated">@color/miuix_primary</item>
        <item name="buttonBarPositiveButtonStyle">@style/AlertDialogButtonStyle</item>
        <item name="buttonBarNegativeButtonStyle">@style/AlertDialogButtonStyle</item>
        <item name="buttonBarNeutralButtonStyle">@style/AlertDialogButtonStyle</item>
    </style>

    <style name="AlertDialogButtonStyle" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textColor">@color/miuix_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
