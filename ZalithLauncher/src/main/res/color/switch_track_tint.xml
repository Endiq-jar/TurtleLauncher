<?xml version="1.0" encoding="utf-8"?>
<!-- Switch track: active = primary green, idle = border strong (solid surfaces, no alpha). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/turtle_border_strong" android:state_enabled="false" />
    <item android:color="@color/accent_primary" android:state_checked="true" />
    <item android:color="@color/turtle_border_strong" />
</selector>
