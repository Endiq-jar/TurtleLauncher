<?xml version="1.0" encoding="utf-8"?>
<!-- TurtleLauncher card: used across popups/cards app-wide. Solid fill + accent edge
     (previously had a gradient glass-highlight overlay layer - removed per user request
     for solid colors throughout instead of gradients). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_panel" />
            <solid android:color="@color/bg_card" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_panel" />
            <stroke android:width="1dp" android:color="@color/turtle_border_default" />
        </shape>
    </item>
</layer-list>
