<?xml version="1.0" encoding="utf-8"?>
<!-- User chat bubble: filled with the primary green (user side), with dark on-accent text
     (see ChatMessageAdapter). The original primary-soft fill rendered dark-on-dark with that
     text color, so the bubble uses the full primary ramp instead. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners
        android:topLeftRadius="@dimen/radius_item"
        android:topRightRadius="@dimen/radius_item"
        android:bottomLeftRadius="@dimen/radius_item"
        android:bottomRightRadius="6dp"/>
    <solid android:color="@color/turtle_primary_soft"/>
</shape>
