<?xml version="1.0" encoding="utf-8"?>
<!-- TurtleLauncher: grid tile for the Settings Hub screen. Same solid/stroke recipe as
     background_card (bg_card fill, subtle border) but with its own radius so hub tiles
     read as a distinct, chunkier tap target than a regular list row. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/turtle_accent_ripple">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_card"/>
            <corners android:radius="18dp"/>
            <stroke android:width="1dp" android:color="@color/turtle_border_default"/>
        </shape>
    </item>
</ripple>
