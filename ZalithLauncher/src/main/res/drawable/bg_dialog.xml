<?xml version="1.0" encoding="utf-8"?>
<!-- Turtle Launcher dialog surface: solid elevated fill + hairline border. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_dialog" />
            <solid android:color="@color/turtle_surface" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_dialog" />
            <stroke android:width="1dp" android:color="@color/turtle_stroke" />
        </shape>
    </item>
</layer-list>
