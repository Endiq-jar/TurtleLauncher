<?xml version="1.0" encoding="utf-8"?>
<!-- TurtleLauncher: pixel-art switch track, "on" state - drawn as vector paths
     instead of a raw pixel-art bitmap (switch_on_raw.png, now removed). Same
     blocky/no-antialiasing look since vector paths render with hard edges at
     these dimensions, matching the turtle mascot's pixel-art style. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="48dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="12">
    <path android:fillColor="#3F54FF" android:pathData="M0,0 H24 V12 H0 Z" />
    <path android:fillColor="#00D404" android:pathData="M13.5,1.5 H22.5 V10.5 H13.5 Z" />
</vector>
