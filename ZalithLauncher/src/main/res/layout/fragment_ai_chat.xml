<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_app">

    <LinearLayout
        android:id="@+id/ai_chat_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/space_l"
        android:paddingVertical="@dimen/space_m"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/back_button"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_chevron_down"
            android:rotation="90"
            android:tint="@color/turtle_text_secondary"
            android:contentDescription="@string/generic_return"/>

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="@dimen/space_s"
            android:src="@drawable/ic_chat"
            android:tint="@color/accent_primary"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_s"
            android:text="@string/ai_chat_title"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/turtle_text_primary"/>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <ImageButton
            android:id="@+id/clear_chat_button"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_menu_delete_forever"
            android:tint="@color/turtle_text_secondary"
            android:contentDescription="@string/ai_chat_clear"/>
    </LinearLayout>

    <TextView
        android:id="@+id/no_api_key_notice"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:background="@drawable/background_card"
        android:padding="@dimen/space_m"
        android:layout_margin="@dimen/space_l"
        android:text="@string/ai_chat_no_api_key"
        android:textSize="13sp"
        android:textColor="@color/turtle_text_secondary"
        app:layout_constraintTop_toBottomOf="@id/ai_chat_header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/message_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/space_l"
        android:paddingVertical="@dimen/space_s"
        app:layout_constraintTop_toBottomOf="@id/ai_chat_header"
        app:layout_constraintBottom_toTopOf="@id/ai_chat_input_row"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <ProgressBar
        android:id="@+id/thinking_indicator"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/ai_chat_input_row"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="@dimen/space_s"/>

    <LinearLayout
        android:id="@+id/ai_chat_input_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/space_l"
        android:paddingVertical="@dimen/space_m"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <EditText
            android:id="@+id/message_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/background_edit_box"
            android:padding="@dimen/space_m"
            android:hint="@string/ai_chat_input_hint"
            android:textSize="14sp"
            android:textColor="@color/turtle_text_primary"
            android:textColorHint="@color/turtle_text_secondary"
            android:maxLines="4"
            android:inputType="textMultiLine|textCapSentences"
            android:importantForAutofill="no"/>

        <ImageButton
            android:id="@+id/send_button"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="@dimen/space_s"
            android:background="@drawable/background_grid_card"
            android:src="@drawable/ic_chevron_down"
            android:rotation="-90"
            android:tint="@color/accent_primary"
            android:contentDescription="@string/ai_chat_send"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
