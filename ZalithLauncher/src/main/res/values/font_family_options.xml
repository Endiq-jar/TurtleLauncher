<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- TurtleLauncher: Accessibility font family picker (roadmap item 22). "Default" uses the
         app's standard professional system font; "Turtle" restores the bundled
         proxima_nova_extrabold branding display font; the rest are Android's built-in system
         families. -->
    <string-array name="all_font_family">
        <item>@string/setting_font_family_default</item>
        <item>@string/setting_font_family_turtle</item>
        <item>@string/setting_font_family_sans</item>
        <item>@string/setting_font_family_condensed</item>
        <item>@string/setting_font_family_serif</item>
        <item>@string/setting_font_family_monospace</item>
    </string-array>
    <string-array name="all_font_family_value">
        <item>default</item>
        <item>turtle</item>
        <item>sans-serif</item>
        <item>sans-serif-condensed</item>
        <item>serif</item>
        <item>monospace</item>
    </string-array>
</resources>
